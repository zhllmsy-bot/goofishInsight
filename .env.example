# Copy to .env for local development or deployment.
# Never commit .env. Keep actual credential values, private hosts, model paths, and tokens there.

POSTGRES_DB=goofish_insight
POSTGRES_USER=goofish
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

ADMINER_PORT=8080
WEB_PORT=3003
APP_ENV=development
DATABASE_URL=postgresql+psycopg://goofish:change-this-password@localhost:5432/goofish_insight
DEFAULT_TASK_KEY=garmin-fenix
BROWSER_PROFILE_DIR=data/browser-profile

AI_PROVIDER=openai_compatible
AI_BASE_URL=https://example.com/v1
AI_API_KEY=replace-with-api-key
AI_MODEL=replace-with-model-name
AI_TIMEOUT_SEC=90
AI_ENABLE_THINKING=false
AI_MAX_TOKENS=600

ARK_AI_PROVIDER=openai_compatible
ARK_AI_BASE_URL=https://example.com/api/coding/v3
ARK_AI_API_KEY=replace-with-ark-api-key
ARK_AI_MODEL=replace-with-ark-model
BAILIAN_CODING_PLAN_API_KEY=replace-with-bailian-api-key
TAVILY_API_KEY=replace-with-tavily-api-key

COZELOOP_BASE_URL=http://127.0.0.1:8888
COZELOOP_WORKSPACE_ID=replace-with-workspace-id
COZELOOP_PAT=replace-with-personal-access-token
COZELOOP_FIRST_PASS_MODEL_ID=1
COZELOOP_FIRST_PASS_MODEL_NAME=replace-with-model-name
COZELOOP_SECOND_PASS_MODEL_ID=1
COZELOOP_SECOND_PASS_MODEL_NAME=replace-with-model-name

MOBILE_OVERLAY_VLM_ENABLED=true
MOBILE_OVERLAY_VLM_BASE_URL=http://127.0.0.1:8020
MOBILE_OVERLAY_VLM_MODEL=replace-with-local-vlm-model-or-path
MOBILE_OVERLAY_VLM_TIMEOUT_SEC=300
MOBILE_OVERLAY_VLM_MAX_OUTPUT_TOKENS=320
MOBILE_OVERLAY_VLM_ENABLE_THINKING=true

LOCAL_QWEN_PYTHON_BIN=python
LOCAL_QWEN_WORKDIR=.
QWEN3_MODEL_PATH=replace-with-local-qwen3-model-or-path
QWEN25_MODEL_PATH=replace-with-local-qwen25-model-or-path
QWEN25_VL_MODEL_PATH=replace-with-local-vlm-model-or-path
QWEN_PROXY_SCRIPT=replace-with-local-proxy-script-path
LOCAL_QWEN_REQUEST_LOG=logs/qwen-requests.jsonl

PRUNE_RAW_AFTER_INGEST=true
LOW_PRICE_FILTER_RATIO=0.35
LOW_PRICE_FILTER_MIN_SAMPLES=8
