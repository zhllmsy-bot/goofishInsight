<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.admin.goofish-review-v3-full-active-resident</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__GOOFISH_RUNTIME_HOME__/start-review-v3-full-active-resident.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GOOFISH_ROOT_DIR</key>
		<string>__GOOFISH_ROOT_DIR__</string>
		<key>WORKER_LABEL</key>
		<string>resident-v3-full-active-worker</string>
		<key>PREFIX_BASE</key>
		<string>review-v3-full-active</string>
		<key>WORKERS</key>
		<string>16</string>
		<key>FIRST_PASS_BATCH_SIZE</key>
		<string>4</string>
		<key>AI_TIMEOUT_SEC</key>
		<string>90</string>
		<key>FIRST_PASS_RETRY_MAX</key>
		<string>3</string>
		<key>SECOND_PASS_RETRY_MAX</key>
		<string>2</string>
		<key>RETRY_BACKOFF_BASE_SEC</key>
		<string>2</string>
		<key>RETRY_BACKOFF_MAX_SEC</key>
		<string>30</string>
		<key>REVIEW_V3_CLI_TIMEOUT_SEC</key>
		<string>150</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>__GOOFISH_RUNTIME_HOME__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>__GOOFISH_LOG_DIR__/goofish-review-v3-full-active-resident.log</string>
	<key>StandardErrorPath</key>
	<string>__GOOFISH_LOG_DIR__/goofish-review-v3-full-active-resident.err.log</string>
</dict>
</plist>
