<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.admin.goofish-review-v2-resident</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__GOOFISH_RUNTIME_HOME__/start-review-v2-resident.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AI_PROVIDER</key>
		<string>openai_compatible</string>
		<key>AI_BASE_URL</key>
		<string>http://127.0.0.1:8000/v1</string>
		<key>AI_API_KEY</key>
		<string>local-dev</string>
		<key>AI_MODEL</key>
		<string>__QWEN3_MODEL_PATH__</string>
		<key>GOOFISH_ROOT_DIR</key>
		<string>__GOOFISH_ROOT_DIR__</string>
		<key>WORKER_LABEL</key>
		<string>resident-v2-worker</string>
		<key>BATCH_SIZE</key>
		<string>10</string>
		<key>LLM_CONCURRENCY</key>
		<string>1</string>
		<key>AI_TIMEOUT_SEC</key>
		<string>30</string>
		<key>PAUSE_SECONDS</key>
		<string>1</string>
		<key>CLAIM_TTL_SEC</key>
		<string>1800</string>
		<key>IDLE_POLL_SECONDS</key>
		<string>30</string>
		<key>ERROR_POLL_SECONDS</key>
		<string>15</string>
		<key>MAX_BATCHES_PER_CYCLE</key>
		<string>0</string>
		<key>EXPECTED_MODEL_SNIPPET</key>
		<string>Qwen3-30B-A3B-MLX-4bit</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>__GOOFISH_RUNTIME_HOME__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__GOOFISH_LOG_DIR__/goofish-review-v2-resident.log</string>
	<key>StandardErrorPath</key>
	<string>__GOOFISH_LOG_DIR__/goofish-review-v2-resident.err.log</string>
</dict>
</plist>
