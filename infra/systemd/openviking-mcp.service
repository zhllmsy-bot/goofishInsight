[Unit]
Description=OpenViking MCP Server
After=network.target

[Service]
Type=simple
User=zh
WorkingDirectory=/home/zh/openviking-mcp
EnvironmentFile=/home/zh/openviking-mcp/openviking-mcp.env
ExecStart=/home/zh/.openviking/venv/bin/python /home/zh/openviking-mcp/server.py
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
